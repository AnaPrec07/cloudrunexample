# .env.example — Copy to .env for local development. NEVER commit .env to git.
# In production, all values are injected via gcloud run deploy --set-env-vars
# and --set-secrets. The .env file is for local `python main.py` runs only.

# ── Required ───────────────────────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# ── Model ─────────────────────────────────────────────────────────────────────
# Available: gemini-2.0-flash-001 | gemini-1.5-pro-002 | gemini-1.5-flash-002
MODEL_ID=gemini-2.0-flash-001

# ── Artifact Registry ─────────────────────────────────────────────────────────
ARTIFACT_REGISTRY_REPO=agent-repo
SERVICE_NAME=cloudrun-agent

# ── Service account name (without @project.iam.gserviceaccount.com) ────────────
SA_NAME=cloudrun-agent-sa

# ── Model Armor ───────────────────────────────────────────────────────────────
# Leave empty to disable Model Armor (safe for development).
# In production this is injected from Secret Manager via --set-secrets.
MODEL_ARMOR_TEMPLATE_ID=

# ── IAM token audience ────────────────────────────────────────────────────────
# Set to your Cloud Run service URL after first deploy.
# Leave empty locally — audience check is skipped when SERVICE_URL is unset.
SERVICE_URL=

# ── Cloud DLP (optional) ──────────────────────────────────────────────────────
# Set to true to enable Cloud DLP as an enhancement layer over regex masking.
# Adds ~50-200ms latency per request. Use in production for regulated data.
USE_CLOUD_DLP=false

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO
